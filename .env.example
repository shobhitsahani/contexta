# --- Core ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://contexta:contexta@localhost:5432/contexta

# --- Better Auth ---
# Must be the public URL of this API (used for OAuth callbacks and links).
BETTER_AUTH_URL=http://localhost:3001
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# --- Web ---
WEB_ORIGIN=http://localhost:3000

# --- Google OAuth (optional in local dev; both or neither) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
# Without a key, emails are logged locally without their links/tokens.
RESEND_API_KEY=
EMAIL_FROM=Contexta <onboarding@resend.dev>

# --- Provider key encryption ---
# Exactly 32 bytes, base64 or hex. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=replace-me-with-32-random-bytes-base64-or-hex

# --- Redis rate limits (memory fallback when absent) ---
REDIS_URL=redis://localhost:6379

# --- Free tier ---
FREE_TOKEN_CAP=50000
# Server-side API key used for the free tier. Never exposed to clients.
FREE_CHAT_API_KEY=
FREE_CHAT_PROVIDER=gemini
FREE_CHAT_MODEL=gemini-2.5-flash

# --- Embeddings ---
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Retrieval ---
DEFAULT_TOP_K=8
DEFAULT_SCORE_THRESHOLD=0.3
HYBRID_SEARCH_ENABLED=true

# --- Provider defaults (BYOK) ---
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# --- HTTP / rate limits ---
# Number of reverse proxies in front of the API (Render = 1).
TRUST_PROXY=0
PROVIDER_TIMEOUT_MS=8000
AUTH_IP_RATE_LIMIT_MAX=30
AUTH_IP_RATE_LIMIT_WINDOW_MS=60000
CHAT_USER_RATE_LIMIT_MAX=120
CHAT_USER_RATE_LIMIT_WINDOW_MS=60000
SETTINGS_USER_RATE_LIMIT_MAX=20
SETTINGS_USER_RATE_LIMIT_WINDOW_MS=60000
USAGE_USER_RATE_LIMIT_MAX=60
USAGE_USER_RATE_LIMIT_WINDOW_MS=60000
